# ── Conjur / Secrets Manager SaaS auth ──
# Copy to .env and fill in. DO NOT commit .env.

# Account name (Conjur Cloud default is "conjur")
CONJUR_ACCOUNT=conjur

# Tenant API base URL — MUST include /api on Conjur Cloud
CONJUR_APPLIANCE_URL=https://<SUBDOMAIN>.secretsmgr.cyberark.cloud/api

# The host identity from policy 02 (data/ansible/apps/domain-retrieve)
CONJUR_AUTHN_LOGIN=host/data/ansible/apps/domain-retrieve

# API key printed once when the host was created (load-policy step)
CONJUR_AUTHN_API_KEY=<your-host-api-key>