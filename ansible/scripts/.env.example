# Conjur Configuration Example
# Copy this file to .env and replace the placeholder values with your actual data.
# WARNING: DO NOT commit the actual .env file to version control!

# Conjur tenant/account name
CONJUR_ACCOUNT=conjur

# Conjur FQDN with scheme and port (e.g., https://conjur.local.domain)
CONJUR_APPLIANCE_URL=https://your-conjur-url.com

# Conjur host/workload identity
# Note: This matches the host created in app.yml
CONJUR_AUTHN_LOGIN=host/data/ansible/apps/conjur-demo

# Conjur host identity API key (Keep this secret!)
CONJUR_AUTHN_API_KEY=<your-conjur-api-key>

# Conjur public key file path
# In case of Conjur cloud, you can comment this out or point to a valid cert
CONJUR_CERT_FILE=~/conjur-server.pem