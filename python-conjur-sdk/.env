CONJUR_URL=https://your-conjur-url
#CONJUR_ACCOUNT=your-conjur-account # Only if using Conjur Enterprise
CONJUR_HOST=host/data/your-app
CONJUR_API_KEY=your-api-key
#CONJUR_SSL_MODE=TRUST_STORE  # Options: TRUST_STORE, INSECURE, or CA_BUNDLE 
#CONJUR_CERT_FILE=/path/to/cert.pem  # Optional path to your certificate file
