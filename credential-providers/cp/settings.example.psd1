# Settings for the CP scripts in this folder.
# Copy to settings.psd1 (the default every script reads) and fill in the <...> values.
# For another environment, copy to e.g. settings-<customer>.psd1 and pass -ConfigPath.
# settings.psd1 and settings-*.psd1 are git-ignored - they hold tenant names and addresses.
#
# The logged-on user typically needs: Add Safes, Manage Users (for Applications), Audit Users,
# and Manage Safe Members on the Safes. In Privilege Cloud, a Privilege Cloud Administrator.

@{
    Connection = @{
        # 'SelfHosted' or 'PrivilegeCloud'
        Type        = 'PrivilegeCloud'

        # Without /PasswordVault. Privilege Cloud: https://<subdomain>.privilegecloud.cyberark.cloud
        PvwaUrl     = 'https://pvwa.lab.local'

        # SelfHosted only: CyberArk / LDAP / RADIUS / Windows
        AuthType    = 'CyberArk'

        # PrivilegeCloud only - logon is an Identity service user (OAuth client ID / secret)
        IdentityUrl = 'https://<identity-tenant-id>.id.cyberark.cloud'

        # Optional - pre-fills the logon prompt, so only the password / secret is asked.
        # It is asked once per PowerShell window and kept in memory only.
        UserName    = '<service-user>'
    }

    # Optional - the Vault the Provider connects to, checked by 1-Preflight on the Provider machine.
    # Privilege Cloud: derived from Connection.PvwaUrl (vault-<subdomain>.privilegecloud.cyberark.cloud).
    # PAM Self-Hosted: required. Address is a host name only - no https://, no path.
    # Vault = @{ Address = 'vault.lab.local'; Port = 1858 }

    # Optional - remove the section when you log on as the admin who should own the Safes.
    # Human owners added to every Safe with full permissions. A Safe created through the API is
    # otherwise owned only by the API user, and the admins cannot see or manage it in the portal.
    # Type: User (default), Group or Role
    SafeOwners = @(
        @{ Name = '<your-admin-user>' }
        # @{ Name = 'Privilege Cloud Administrators'; Type = 'Role' }
    )

    Applications = @(
        @{
            # The application that retrieves the password through the CP on its own machine - one AppID per application.
            AppId           = 'CP-Demo-App'
            Description     = 'CP demo application'

            # Authentication methods - the Provider checks every one that is set.
            # With none, any process on any machine with a Provider can retrieve with this AppID.
            AllowedMachines = @('<app-machine-ip>')    # The application machine - the CP runs on it
            # OSUsers       = @('svc_app')             # The OS user the application runs as
            # Paths         = @('C:\Apps\Demo\app.exe') # The executable that calls the CP
            # Hashes        = @('<hash from AIMGetAppInfo>')
        }
    )

    Safes = @(
        @{
            Name      = 'Credential-Providers'

            # AppIDs get Retrieve + List
            AppIds    = @('CP-Demo-App')

            # Provider user of each CP host that serves this Safe - gets Retrieve + List + View Safe Members.
            # The installation creates it - Prov_<host name> by default. Leave empty to list the Providers in the Vault.
            Providers = @('Prov_<cp-hostname>')

            Accounts  = @(
                # An account is identified by UserName + Address. The script reads back its actual
                # Object name (auto-generated by the platform unless Name is set) and prints the CP query.
                @{
                    # Any active password platform works - the CP does not care. The Safe is created
                    # without a managing CPM, so the demo password is never rotated against a real target.
                    PlatformId = 'PostgreSQL'
                    Address    = 'db.lab.local'
                    UserName   = 'reception'
                    # Name     = '<object name>'                   # Optional - overrides the platform naming
                    # Secret   = '<password>'                      # Optional - random when omitted
                }
            )
        }
    )
}
